# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API.
# Only the public "anon" (publishable) key belongs here.
# NEVER put the service_role / secret key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Max size of a single upload in MB. Must be <= the bucket's file_size_limit
# (50 MB on the Supabase Free plan). Raise both on a paid plan to store longer
# videos, e.g. 5120 for 5 GB (see README, setup step 8).
VITE_MAX_UPLOAD_MB=50
